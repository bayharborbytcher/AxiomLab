{
 "name": "Full adder",
 "description": "Adds two bits plus a carry-in.",
 "gates": {
  "A0": ["INPUT", -480, -240],
  "B0": ["INPUT", -440, -80],
  "X1_0": ["XOR", -180, -220],
  "A1_0": ["AND", -180, -40],
  "X2_0": ["XOR", 160, -220],
  "A2_0": ["AND", 160, 120],
  "OR_0": ["OR", 360, -60],
  "S0": ["OUTPUT", 380, -220],
  "Cin": ["INPUT", -120, 200],
  "Cout": ["OUTPUT", 580, -60]
 },
 "wires": [
  ["A0", 0, "X1_0", 0],
  ["A0", 0, "A1_0", 0],
  ["B0", 0, "X1_0", 1],
  ["B0", 0, "A1_0", 1],
  ["X1_0", 0, "X2_0", 0],
  ["X1_0", 0, "A2_0", 0],
  ["Cin", 0, "X2_0", 1],
  ["Cin", 0, "A2_0", 1],
  ["X2_0", 0, "S0", 0],
  ["A1_0", 0, "OR_0", 0],
  ["A2_0", 0, "OR_0", 1],
  ["OR_0", 0, "Cout", 0]
 ]
}
