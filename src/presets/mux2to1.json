  "A": ["INPUT", -460, -300],
  "B": ["INPUT", -460, -60],
  "S": ["INPUT", -460, 120],
  "N": ["NOT", -220, 260],
  "P": ["AND", 20, -260],
  "Q": ["AND", 20, -60],
  "O": ["OR", 260, -160],
  "Y": ["OUTPUT", 440, -160]
 },
 "wires": [
  ["A", 0, "P", 0],
  ["S", 0, "N", 0],
  ["N", 0, "P", 1],
  ["B", 0, "Q", 0],
  ["S", 0, "Q", 1],
  ["P", 0, "O", 0],
  ["Q", 0, "O", 1],
  ["O", 0, "Y", 0]
 ]
}
